{
  "name": "openaidr-dashboard",
  "private": true,
  "scripts": {
    "sync-brand": "node scripts/sync-brand.mjs",
    "dev": "node scripts/sync-brand.mjs && next dev",
    "build": "node scripts/sync-brand.mjs && next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/apps/dashboard/server.js",
    "typecheck": "tsc --noEmit",
    "check:design": "node scripts/check-design.mjs",
    "check:colors": "node scripts/check-colors.mjs",
    "test:proxy": "node --test scripts/test-telemetry-proxy.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "ae-cvss-calculator": "1.0.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "1.7.2",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3"
  }
}
